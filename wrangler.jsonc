{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "python-agent-gateway",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-17",
	"observability": { "enabled": true },

	// Static UI. Only /api/* runs the Worker first.
	"assets": {
		"directory": "./public",
		"run_worker_first": ["/api/*"]
	},

	// Model access for the gateway. The container reaches it through an outbound intercept.
	"ai": { "binding": "AI", "remote": true },
	"vars": { "MODEL": "@cf/google/gemma-4-26b-a4b-it" },

	// The Python Worker (see python-worker/), called over a service binding.
	"services": [{ "binding": "PYTHON_AGENT", "service": "python-agent-worker" }],

	// The Python container. The Durable Object picks the image when it starts it.
	"containers": [
		{
			"class_name": "AgentContainer",
			"scheduling_policy": "durable_object",
			"images": {
				"base": {
					"dockerfile": "./container/Dockerfile",
					"build_context": "."
				}
			}
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "AGENT_CONTAINER", "class_name": "AgentContainer" }]
	},
	"exports": {
		"AgentContainer": { "type": "durable-object", "storage": "sqlite" }
	}
}
